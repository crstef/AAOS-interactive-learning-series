<?xml version="1.0" encoding="utf-8"?>
<!--
    The front layer of the icon: a white calculator with a display and 9 keys.

    The adaptive icon is 108×108 dp, but the system crops it (circle, rounded square...)
    into the shape chosen by the car manufacturer. Only the central 66 dp circle is
    guaranteed to be visible (the "safe zone", from 21 to 87), so the drawing stays inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The calculator body: a white rectangle with rounded corners (x 36–72, y 29–79). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,29h26a5,5 0,0 1,5 5v40a5,5 0,0 1,-5 5h-26a5,5 0,0 1,-5 -5v-40a5,5 0,0 1,5 -5z" />

    <!-- The display: light green, like the LCD screens of classic calculators. -->
    <path
        android:fillColor="#B9F6CA"
        android:pathData="M42,33h24a2,2 0,0 1,2 2v7a2,2 0,0 1,-2 2h-24a2,2 0,0 1,-2 -2v-7a2,2 0,0 1,2 -2z" />

    <!-- The keys: a 3×3 grid in the background color (blue). -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M40,48h7v7h-7z M50.5,48h7v7h-7z M61,48h7v7h-7z
                          M40,58h7v7h-7z M50.5,58h7v7h-7z M61,58h7v7h-7z
                          M40,68h7v7h-7z M50.5,68h7v7h-7z" />

    <!-- The "=" key in the bottom-right corner: orange, so it stands out. -->
    <path
        android:fillColor="#FF9800"
        android:pathData="M61,68h7v7h-7z" />
</vector>
